# Optional AI service. Keep secret values on the server.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
# Optional override. Defaults: dev API 8787; npm start 4188.
# PORT=4188
# Browser/public configuration for optional authenticated cloud backup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Required for authenticated AI in a hosted environment.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Local development only: requests must originate from localhost.
ALLOW_LOCAL_AI=true
