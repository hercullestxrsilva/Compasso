{
  // The end-to-end suite (npm run test:e2e) runs in Node, not in the app bundle. Checked by `tsc -b` through
  // the reference in tsconfig.json; a referenced project must emit, so its declarations go to node_modules.
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig.e2e",
    "tsBuildInfoFile": "tsconfig.e2e.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "e2e"]
}
